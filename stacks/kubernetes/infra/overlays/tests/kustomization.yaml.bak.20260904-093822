apiVersion: kustomize.config.k8s.io/v1beta1
kind: Kustomization

resources:
  - ../../apps/demo/nginx/configmap-nginx.yaml
  - ../../apps/demo/nginx/deployment-nginx.yaml
  - ../../apps/demo/nginx/service-nginx.yaml
  - ../../apps/demo/grafana/configmap-grafana.yaml
  - ../../apps/demo/grafana/deployment-grafana.yaml
  - ../../apps/demo/grafana/ingress-grafana.yaml
  - ../../apps/demo/grafana/service-grafana.yaml
  - ../../apps/demo/prometheus/config-configmap-prometheus.yaml
  - ../../apps/demo/prometheus/rules-configmap-prometheus.yaml
  - ../../apps/demo/prometheus/deployment-prometheus.yaml
  - ../../apps/demo/prometheus/ingress.yaml
  - ../../apps/demo/prometheus/service-prometheus.yaml

patches:
  - path: ../../apps/demo/nginx/deployment-nginx.yaml
    target:
      kind: Deployment
      name: nginx
